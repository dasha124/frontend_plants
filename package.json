		"react-router-dom": "^6.27.0",
		"tailwind-merge": "^2.5.4"
	},
	"devDependencies": {
		"@eslint/eslintrc": "^3.1.0",
		"@eslint/js": "^9.11.1",
		"@types/node": "^22.7.5",
